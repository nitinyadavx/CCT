{
  "manifest_version": 3,
  "name": "CCT",
  "short_name": "CCT",
  "version": "8.0.0",
  "description": "Complete your college online course in one click.",
  "homepage_url": "https://github.com/nitinyadavx/CCT",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CCT",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
